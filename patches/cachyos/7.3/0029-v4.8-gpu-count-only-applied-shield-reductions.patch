From 03f2d0d0014a03735eb8d7c232978f8cb7a3a51d Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 18:25:39 +0700
Subject: [PATCH 29/40] v4.8-gpu: count only applied shield reductions

The shield engage counter incremented on every update_cfs_group()
evaluation that computed a non-zero reduction, which runs per tick via
entity_tick even when the group share is already at its reduced value.
The count therefore overstated applied reductions by roughly three orders
of magnitude.  The counter now fires only when the shield-induced share
actually differs from the current weight and reweight_entity() runs.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index ea8a688cf..dd6924ed6 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5157,6 +5157,7 @@ static void update_cfs_group(struct sched_entity *se)
 {
 	struct cfs_rq *gcfs_rq = group_cfs_rq(se);
 	long shares;
+	bool shield_reduced = false;
 
 	/*
 	 * When a group becomes empty, preserve its weight. This matters for
@@ -5231,11 +5232,22 @@ static void update_cfs_group(struct sched_entity *se)
 				long reduced = shares * (100ULL - red) / 100ULL;
 
 				shares = max_t(long, reduced, MIN_SHARES);
-				atomic64_inc(this_cpu_ptr(&infinity_shield_engage_count));
+				shield_reduced = true;
 			}
 		}
 	}
 
+	/* Infinity: the shield counter counts only shield-induced
+	 * reweights that actually changed the group share.  It
+	 * previously incremented on every update_cfs_group()
+	 * evaluation (per tick via entity_tick), overstating
+	 * applied reductions by ~3 orders of magnitude.
+	 * reweight_entity() self-guards on an unchanged weight, so the
+	 * comparison is made here, before the share is installed.
+	 */
+	if (shield_reduced && se->load.weight != shares)
+		atomic64_inc(this_cpu_ptr(&infinity_shield_engage_count));
+
 	reweight_entity(cfs_rq_of(se), se, shares);
 }
 
